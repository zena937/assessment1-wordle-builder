generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Word {
  id          String    @id @default(cuid())
  word        String    @unique
  phonemes    String[]
  hint        String?
  difficulty  String    @default("EASY")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  activities  ActivityWord[]
}

model Activity {
  id          String    @id @default(cuid())
  name        String
  type        String    @default("WORDLE")
  description String?
  maxAttempts Int?      @default(6)
  gridSize    Int?      @default(12)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  words       ActivityWord[]
}

model ActivityWord {
  id          String    @id @default(cuid())
  activityId  String
  wordId      String
  order       Int
  activity    Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  word        Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

model ActivityEvent {
  id           String   @id @default(cuid())
  eventType    String   // "CREATED" | "GENERATED" | "FAILED" | "VIEWED"
  activityType String   // "WORDLE" | "WORDSEARCH"
  activityId   String?
  wordCount    Int?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([eventType])
  @@index([activityType])
  @@index([createdAt])
}

model PageView {
  id         String   @id @default(cuid())
  path       String
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([path])
  @@index([createdAt])
}

model UsageStat {
  id        String   @id @default(cuid())
  metric    String   @unique  // e.g. "wordle_created", "wordle_generated", "wordle_failed"
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}